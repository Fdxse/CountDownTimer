<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small Windows desktop (WPF) app. No external NuGet packages are used. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CountDownTimer</AssemblyName>
    <RootNamespace>CountDownTimer</RootNamespace>
    <!-- Lets the project also be built from non-Windows machines (e.g. CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
