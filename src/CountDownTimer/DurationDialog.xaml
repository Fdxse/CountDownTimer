<!-- Small dialog where the user types how long the countdown should be. -->
<Window x:Class="CountDownTimer.DurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown timer"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FocusManager.FocusedElement="{Binding ElementName=DurationTextBox}">
    <StackPanel Margin="16" MinWidth="280">
        <TextBlock Text="How long should the timer count down?" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,8" Foreground="Gray" TextWrapping="Wrap" MaxWidth="280"
                   Text="Examples: 5 (minutes), 4:30, 1:15:00, 90s, 1h 30m" />

        <TextBox x:Name="DurationTextBox" FontSize="16" Padding="4" />

        <!-- Shown only when the input could not be understood. -->
        <TextBlock x:Name="ErrorTextBlock" Margin="0,4,0,0" Foreground="Firebrick"
                   Visibility="Collapsed" Text="That doesn't look like a duration. Try 5, 4:30 or 90s." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Start" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnStartClicked" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
