<!--
    The on-screen timer. The window has no border and a transparent background,
    so only the digits are visible. It always stays on top of other windows.
    It starts in the upper right corner of the screen (see TimerWindow.xaml.cs).

    Background is "#01000000": 1/255 opaque black. It looks fully invisible but lets
    the mouse grab the whole timer area (fully transparent pixels ignore the mouse).
-->
<Window x:Class="CountDownTimer.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown timer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SizeChanged="OnSizeChanged"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseWheel="OnMouseWheel"
        KeyDown="OnKeyDown">

    <!-- Right-click menu with all the controls. -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="PauseMenuItem" Header="_Pause" InputGestureText="Space" Click="OnPauseClicked" />
            <MenuItem Header="_Restart" InputGestureText="R" Click="OnRestartClicked" />
            <MenuItem Header="Set _new time..." InputGestureText="N" Click="OnNewTimeClicked" />
            <Separator />
            <MenuItem Header="_Close" InputGestureText="Esc" Click="OnCloseClicked" />
        </ContextMenu>
    </Window.ContextMenu>

    <TextBlock x:Name="TimeTextBlock"
               Text="00:00"
               FontFamily="Consolas"
               FontWeight="Bold"
               FontSize="72"
               Foreground="White"
               Margin="8,0">
        <!-- Dark glow around the digits so they stay readable on light and dark backgrounds. -->
        <TextBlock.Effect>
            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="8" Opacity="1" />
        </TextBlock.Effect>
    </TextBlock>
</Window>
